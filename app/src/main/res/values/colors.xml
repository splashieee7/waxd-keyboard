<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="key_press_color">#11ffffff</color>

    <!--
        Waxd terminal/ops-console theme. Same four hex values as every other
        waxd reskin. Unlike Launcher, this app derives keyboard/key/stroke
        colors from these at runtime via darken/lightenColor() HSL shifts
        (see extensions/KeyboardThemeExt.kt) rather than using them directly;
        verified by hand that a near-black background still produces a real,
        visible lightness step for key faces and (with key borders on by
        default) an even clearer stroke outline, so keys don't blend into the
        background.
    -->
    <color name="waxd_background">#0A0C0A</color>
    <color name="waxd_text">#D8F5E0</color>
    <color name="waxd_primary">#2E9E5B</color>
    <color name="waxd_accent">#4CFF8B</color>

    <color name="default_background_color">@color/waxd_background</color>
    <color name="default_text_color">@color/waxd_text</color>
    <color name="default_primary_color">@color/waxd_primary</color>
    <color name="default_accent_color">@color/waxd_accent</color>
    <color name="default_app_icon_color">@color/waxd_primary</color>
    <color name="default_widget_text_color">@color/waxd_primary</color>
</resources>
